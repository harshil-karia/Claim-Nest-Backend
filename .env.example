PORT=3000
MONGODB_URI=
NODE_ENV=development
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-jwt-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_PASSWORD_SECRET=your-jwt-reset-secret
